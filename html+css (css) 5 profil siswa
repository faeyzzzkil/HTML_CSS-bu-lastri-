body {
    font-family: Arial, sans-serif;
}

.kartu {
    width: 300px;
    padding: 20px;
    margin: 30px auto;
    background-color: #04ffff;
    border: 1px solid #fafcf7;
    text-align: left;
    border-radius: 5px;
    box-shadow: 0px 0px 10px #011616;
}

.kartu h1 {
    color: rgb(8, 8, 247);
    font-size: 28px;
    text-align: center;
}

.kartu img {
    width: 100px;
    height: auto;
    border-radius: 5px;
}

.kartu h2 {
    color: rgb(253, 152, 1);
    font-size: 20px;
}

.kartu p {
    color: #333;
    font-size: 16px;
    line-height: 1.5;
}

.kartu button {
    padding: 10px 20px;
    border: none;
    background-color: rgb(39, 224, 2);
    color: white;
    text-align: center;
}
